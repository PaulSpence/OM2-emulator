#!/bin/bash
# Run notebooks/Emulator_intercomparison.ipynb headless on one Hopper GPU.
# Same project, CPUs, memory, jobfs, storage, software and environment as the
# ARE JupyterLab session it was developed in; only the queue (and walltime) differ.
#
#   qsub -v NOTEBOOK_COMMIT=$(git rev-parse HEAD) jobs/run_intercomparison.pbs
#
# The notebook is taken from git at NOTEBOOK_COMMIT (default: HEAD when the job
# starts), so editing or saving the working copy cannot change a queued run.
# Outputs go where the notebook's RUN_NAME says (runs/<RUN_NAME>/,
# figures/<RUN_NAME>/); stages with saved weights there are loaded, not retrained.
# The executed notebook, with all outputs, and this log go to runs/.
#PBS -N om2-intercomparison
#PBS -P v46
#PBS -q gpuhopper
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=97280M
#PBS -l jobfs=100GB
#PBS -l walltime=24:00:00
#PBS -l storage=gdata/cj50+gdata/e14+gdata/v46+gdata/p73+gdata/v45+gdata/x77+gdata/fs38+gdata/ik11+gdata/oi10+gdata/xp65+gdata/g40+gdata/ol01+gdata/nm47+gdata/dk92+gdata/rv74+gdata/rq0
#PBS -l wd
#PBS -j oe
#PBS -o /home/156/txs156/uom/OM2-emulator/runs/

set -euo pipefail

REPO=/home/156/txs156/uom/OM2-emulator
module use /g/data/dk92/apps/Modules/modulefiles
module load pet/2025.05
export PYTHONUSERBASE=/g/data/v46/txs156/python-userbase

cd "$REPO"
COMMIT=${NOTEBOOK_COMMIT:-$(git rev-parse HEAD)}
JOB=${PBS_JOBID%%.*}
INPUT=runs/Emulator_intercomparison_${JOB}.ipynb
git show "${COMMIT}:notebooks/Emulator_intercomparison.ipynb" > "$INPUT"
echo "Job ${PBS_JOBID} on $(hostname) at $(date); notebook from commit ${COMMIT}"
nvidia-smi --query-gpu=name,memory.total --format=csv

jupyter nbconvert --to notebook --execute \
    --ExecutePreprocessor.timeout=-1 \
    --ExecutePreprocessor.kernel_name=python3 \
    --output-dir runs \
    --output "Emulator_intercomparison_${JOB}_executed" \
    "$INPUT"

echo "Finished at $(date)"
